# Railway: set variables in the dashboard. Never commit .env.local.
PAPER=1
DATA_MODE=demo
PORT=3100
WORKER_PORT=3101
WORKER_URL=http://127.0.0.1:3101
DATA_DIR=./data
# Keep disabled for a public deployment.
ALLOW_LOCAL_CONTROLS=0
KILL_SWITCH=0
# Public base URL, used for social previews. Set after generating your Railway domain.
PUBLIC_URL=http://localhost:3100
# Explicit test/project labeling. Change only after configuring your real project.
BOARD_MODE=test
TOKEN_MINT=
# Creator and treasury use this one public address.
CREATOR_WALLET=
# Server-only Helius URL. Do not use a NEXT_PUBLIC_ prefix.
RPC_URL=
# Optional stable random value to preserve anonymous gallery cookies across deploys.
AUDIENCE_SECRET=
# Optional Postgres snapshot store; volume-backed file persistence works without it.
DATABASE_URL=
# Optional Jupiter API key for wallet-backed modes; model settings remain unused by demo.
JUPITER_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
SMART_MODEL=
FAST_MODEL=

# Optional wallet-backed mode: demo (default), shadow (read-only), live (signs swaps).
# In live mode also set PAPER=0 and LIVE_TRADING_ENABLED=1 explicitly.
# CREATOR_WALLET must exactly match this key's public address. Never put this key in chat.
TRADING_PRIVATE_KEY=
LIVE_TRADING_ENABLED=0
# Every wallet SOL deposit increases the budget. 0.03 SOL stays reserved for fees.
# One replica only; /app/data must be persistent. KILL_SWITCH=1 stops new orders.

# Private credential for the owner-only start/stop API. Never expose it in client code.
TRADING_CONTROL_TOKEN=
# Signing capability does not start automatic trading: the owner control must start it.
# Optional private Pyth Pro access for the independent research panel.
PYTH_PRO_API_KEY=
